# Copy to .env (repo root) on the server. .env is git-ignored; tools/env.sh loads it for every tools/*.sh script.

# folder with the site recorders (score_watch.py, pick_watch.py, caster_watch.py, live_relay.py, match_watch.py,
# build_owcs_data.py, admin_server.py, replay_comment.py). Empty = not on this machine (they are skipped).
OWCSKR_SITE_DIR=

# clone of the private repo owcs-kr-recorders (backup.py). Empty = skip the daily backup.
OWCSKR_RECORDERS_DIR=

# Discord webhook for alerts (match-day check, SOOP quality). Empty = alerts go to the logs only.
OWCSKR_DISCORD_WEBHOOK=

# GitHub token for tools/publish_day.py (gh api). Fine-grained, this repo only, Contents: read and write.
GH_TOKEN=

# optional: python to use (default: .venv/bin/python, else python3) and tesseract binary (default: from PATH)
# OWCSKR_PYTHON=
# TESSERACT_CMD=
