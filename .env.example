# Copy to .env (repo root) on the server and 'chmod 600 .env'. .env is git-ignored.
# tools/env.sh reads it for every tools/*.sh script, and the systemd units it starts read it as EnvironmentFile=.
#
# Format (the two readers agree only on this; anything else stops the jobs with an error):
#   - one KEY=VALUE per line, no spaces around '=', no 'export'
#   - blank lines and lines starting with '#' are ignored; a '#' after a value is part of the value
#   - quote values containing spaces: KEY="/home/u/OWCS KR Home" (single quotes work too); the quotes are removed
#   - no backslashes, no $VARIABLES (not expanded), no line continuations
#   - save with LF line endings (a file edited on Windows: dos2unix .env)

# folder with the site recorders (score_watch.py, pick_watch.py, caster_watch.py, live_relay.py, match_watch.py,
# build_owcs_data.py, admin_server.py, replay_comment.py). Empty = not on this machine (they are skipped).
# Set but missing = an error with an alert (a typo here would otherwise skip the recorders every match day).
OWCSKR_SITE_DIR=

# clone of the private repo owcs-kr-recorders (backup.py). Empty = skip the daily backup.
OWCSKR_RECORDERS_DIR=

# Discord webhook for alerts (daily job, capture, match-day check, SOOP quality, site freshness, site dispatch,
# units that failed for good).
# Empty = alerts go to the logs only.
OWCSKR_DISCORD_WEBHOOK=

# GitHub token (fine-grained), used by tools/publish_day.py (gh api), tools/dispatch_site.py (gh workflow run) and by
# git through 'gh auth setup-git'.
#   OWCSKR (this repo): Contents read and write - publish_day.py, and the discovery commit when OWCSKR_AUTOPUSH=1
#   owcs-kr (site repo): Contents read and write - only when the recorders in OWCSKR_SITE_DIR push live data from here
#   owcs-kr-recorders: Contents read and write - only with OWCSKR_RECORDERS_DIR (backup.py)
#   owcs-kr (site repo): Actions read and write - only with OWCSKR_SITE_DISPATCH=1 (gh workflow run pages.yml)
# Fine-grained tokens expire: note the date and renew before it.
GH_TOKEN=

# healthchecks.io-style ping URLs (https://hc-ping.com/<uuid>); empty = no pings. A failed ping never fails a job.
#   daily: pinged when the daily job ends ok, <url>/fail when a step failed. Check period 1 day, grace 2 h.
#   live:  <url>/start when a capture starts, <url> when it ends ok, <url>/fail when it failed (match days only).
#          Grace longer than the longest capture (14 h): healthchecks alerts when no end ping follows /start in time.
OWCSKR_HC_DAILY=
OWCSKR_HC_LIVE=

# the daily job finds new Liquipedia pages (node collector/run-lp.mjs --discover). When data/competitions.json or
# data/active.json changed: OWCSKR_AUTOCOMMIT=1 commits the two files, OWCSKR_AUTOPUSH=1 also pushes the commit
# (needs git user.name / user.email and GH_TOKEN with Contents write on OWCSKR). Default 0: changes stay local.
# On the server set both to 1, never AUTOCOMMIT alone: unpushed local commits make every later git pull --ff-only fail.
OWCSKR_AUTOCOMMIT=0
OWCSKR_AUTOPUSH=0

# 1 = during each match day's capture window, start a site build every 10 minutes (tools/dispatch_site.py:
# gh workflow run pages.yml -R dlworhs11-rgb/owcs-kr), a second trigger next to cron-job.org. Needs gh and GH_TOKEN
# with Actions read and write on owcs-kr (above). Alerts after 3 failed dispatches in a row. Default 0.
# OWCSKR_SITE_REPO overrides the site repo (owner/name).
OWCSKR_SITE_DISPATCH=0

# 0 = shadow run: the capture still reads and assembles every map, but nothing is uploaded or posted - no
# tools/publish_day.py (live_capture.py, republish_recent.py; logged 'publish off (OWCSKR_PUBLISH=0)') and no SOOP
# replay comment (run_live.sh, run_daily.sh); a missing gh / GitHub token is then only a self-check warning.
# 1 (the default when not set) = publish. A new server starts at 0 while the Windows PC still publishes, and goes to 1
# once the PC's tasks are removed (docs/linux-server.md "섀도 운영"): only one machine may publish a day.
OWCSKR_PUBLISH=0

# where the capture (tools/live_capture.py) takes its frames:
#   hls  the SOOP stream through yt-dlp + ffmpeg (tools/frames.py), no OBS and no virtual display: the recommended
#        server source (OBS's browser source is not known to work on ARM). Needs ffmpeg (apt) and yt-dlp (in the venv
#        from requirements.txt; tools/env.sh puts .venv/bin on PATH). FFMPEG_CMD / YTDLP_CMD point to other binaries.
#   obs  OBS browser source (the Windows PC; on Linux OBS runs on Xvfb). The default when not set.
# With hls, run_live.sh starts no Xvfb and the OBS parts of matchday_check.py / soop_quality.py are skipped.
OWCSKR_FRAME_SOURCE=hls
# SOOP channel id of the broadcast (https://play.sooplive.com/<channel>), default owesports
OWCSKR_HLS_CHANNEL=owesports
# 1 = decode keyframes only (ffmpeg -skip_frame nokey): far less CPU, frame times snap to the keyframe interval
# (1-2 s; check with tools/frames_probe.py --keyframes-only on a match day before turning it on). Default 0.
OWCSKR_HLS_KEYFRAMES=0

# optional: python to use (default: .venv/bin/python - the only supported setup), tesseract binary (default: from
# PATH), the deployed site that tools/healthcheck.py checks (default https://owticker.com/)
# OWCSKR_PYTHON=
# TESSERACT_CMD=
# OWCSKR_SITE_URL=
